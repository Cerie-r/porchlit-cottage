# Copy to .env next to compose.yaml and fill in what you need. All of it is optional.

# The port on this computer the house opens on (http://localhost:3000).
PORT=3000

# The address the AI keys are written with, if people reach this house by a domain name:
# PUBLIC_URL=https://porchlit.example.com

# The AI keys' signing secret. Left empty, one is made the first time and kept in the `keep` volume.
# If you set one, use at least 20 random characters, and never change it: every AI's key would stop working.
# PORCHLIT_KEY_SECRET=

# Accounts whose own things (src/ours/) are sent to them, and who run the place (invitations, reports):
# OURS_ACCOUNTS=your-username

# Names kept for an AI that hasn't hung its door plate yet, comma-separated:
# PORCHLIT_KEPT_NAMES=
